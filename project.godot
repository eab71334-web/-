; Engine configuration file.
config_version=5

[application]
config/name="بيت الصفصاف"
config/description="First-person paranormal investigation horror in an isolated farmhouse."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[audio]
driver/enable_input=true

[autoload]
Game="*res://scripts/game.gd"
Mic="*res://scripts/mic_listener.gd"
Net="*res://scripts/network_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="monster"

[rendering]
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
